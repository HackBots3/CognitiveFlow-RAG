# CognitiveFlow Environment

# ---- App ----
APP_ENV=development
APP_NAME=CognitiveFlow
LOG_LEVEL=INFO

# ---- Postgres ----
DATABASE_URL=postgresql+asyncpg://cognitive:cognitive@postgres:5432/cognitiveflow

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=docs

# ---- Ollama (host-native on Windows) ----
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_LLM_MODEL_HEAVY=llama3.1:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_LLM_TEMPERATURE=0.1
OLLAMA_LLM_MAX_TOKENS=2048

# ---- Reranker (HuggingFace, downloads on first run) ----
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Tavily (free tier, 1000 searches/month) ----
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ---- Langfuse Cloud (sign up at cloud.langfuse.com — FREE 50k traces/mo) ----
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx

# ---- Semantic Cache ----
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# ---- Retrieval ----
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RERANK_TOP_K=4
RRF_K=60

# ---- Agentic Graph ----
QUERY_REWRITE_MAX_ITER=2
HALLUCINATION_THRESHOLD=0.7

# ---- Storage ----
UPLOAD_DIR=/app/uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200